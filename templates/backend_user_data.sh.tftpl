#!/bin/bash
# Backend bootstrap: tiny stdlib-only Python API on :8080 (/health, /api/info, /api/db-health).
# No DB credentials are placed here. OS-agnostic: python3 is installed with whichever package
# manager exists (dnf / yum / apt-get) only if missing.
set -euo pipefail
exec > >(tee -a /var/log/app-bootstrap.log) 2>&1
echo "[bootstrap] backend start $(date -u +%FT%TZ)"

install_pkgs() {
  if command -v dnf >/dev/null 2>&1; then
    dnf install -y "$@"
  elif command -v yum >/dev/null 2>&1; then
    yum install -y "$@"
  elif command -v apt-get >/dev/null 2>&1; then
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y
    apt-get install -y "$@"
  else
    echo "[bootstrap] ERROR: no supported package manager (dnf/yum/apt-get)" >&2
    exit 1
  fi
}

command -v python3 >/dev/null 2>&1 || install_pkgs python3
command -v curl >/dev/null 2>&1 || install_pkgs curl

id appsvc >/dev/null 2>&1 || useradd --system --shell /bin/false appsvc

mkdir -p /opt/app
cat > /opt/app/app.py <<'PYEOF'
import json, os, socket, urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

DB_HOST = os.environ["DB_HOST"]
DB_PORT = int(os.environ["DB_PORT"])


def imds(path):
    try:
        req = urllib.request.Request(
            "http://169.254.169.254/latest/api/token", method="PUT",
            headers={"X-aws-ec2-metadata-token-ttl-seconds": "60"})
        token = urllib.request.urlopen(req, timeout=2).read().decode()
        req = urllib.request.Request(
            "http://169.254.169.254/latest/meta-data/" + path,
            headers={"X-aws-ec2-metadata-token": token})
        return urllib.request.urlopen(req, timeout=2).read().decode()
    except Exception:
        return "unknown"


class Handler(BaseHTTPRequestHandler):
    def _send(self, code, body):
        data = json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        path = self.path.split("?")[0]
        if path == "/health":
            # Liveness only: must not depend on the DB, or a DB blip would drain the whole tier.
            self._send(200, {"status": "ok"})
        elif path in ("/api", "/api/", "/api/info"):
            self._send(200, {"tier": "backend",
                             "instance_id": imds("instance-id"),
                             "availability_zone": imds("placement/availability-zone")})
        elif path == "/api/db-health":
            try:
                socket.create_connection((DB_HOST, DB_PORT), timeout=3).close()
                self._send(200, {"db_tcp_reachable": True})
            except OSError as exc:
                self._send(503, {"db_tcp_reachable": False, "error": type(exc).__name__})
        else:
            self._send(404, {"error": "not found"})

    def log_message(self, fmt, *args):
        print("%s - %s" % (self.address_string(), fmt % args), flush=True)


if __name__ == "__main__":
    ThreadingHTTPServer(("0.0.0.0", 8080), Handler).serve_forever()
PYEOF
chmod 0755 /opt/app/app.py

cat > /etc/systemd/system/app.service <<'EOF'
[Unit]
Description=Backend sample API
After=network-online.target
Wants=network-online.target

[Service]
User=appsvc
Environment=DB_HOST=${db_host}
Environment=DB_PORT=${db_port}
ExecStart=/usr/bin/env python3 /opt/app/app.py
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable app.service
systemctl restart app.service
echo "[bootstrap] backend done $(date -u +%FT%TZ)"
