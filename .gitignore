# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
tfplan
plan.out
plan.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Variable files (may contain real domains / emails). Only the .example is committed.
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Real backend settings (bucket name etc.). backend.tf itself IS committed; it holds no values.
*.tfbackend

# Secrets / keys
*.pem
*.key
*.p12
*.pfx
id_rsa*
.env
.env.*
*.secret
credentials
.aws/

# Local tooling
.claude/
*.log
.venv/
__pycache__/
.checkov*/
.DS_Store
Thumbs.db
.idea/
.vscode/
